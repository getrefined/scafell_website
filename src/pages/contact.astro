---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site } from '../config/site';
import { getPageSlices, sliceOf } from '../lib/prismicio';
import heroContact from '../assets/images/hero-contact.jpg';

const slices = await getPageSlices('contact');
const heroSlice = sliceOf(slices, 'hero_slice');
---

<Base
  title="Contact | The Scafell Hotel"
  description="Whether you're planning a relaxing getaway, booking a table, organising an event or simply have a question, our team is here to help."
>
  <Hero
    image={heroContact}
    alt="The valley around The Scafell Hotel"
    title={heroSlice?.primary?.heading || 'Here to help'}
    short
  />

  <main>
    <section class="section container">
      <div class="contact-grid">
        <div class="reveal">
          <p class="contact-lead">
            Whether you're planning a relaxing getaway, booking a table, organising an event or
            simply have a question, our team is here to help.
          </p>

          <div class="contact-card">
            <h2>Contact Information</h2>
            <address>
              {site.address.line1}<br />
              {site.address.line2}<br />
              {site.address.village}<br />
              {site.address.town}<br />
              {site.address.postcode}<br />
              {site.address.country}
            </address>
            <p>
              <strong>Phone:</strong>
              <a href={site.phoneHref}>{site.phone}</a><br />
              <strong>Email:</strong>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
            <a class="btn" href={site.directionsUrl}>Get directions</a>
          </div>
        </div>

        <div class="reveal">
          <h2>Enquiry Form</h2>
          <p>
            Complete our enquiry form and a member of our team will get back to you as soon as
            possible.
          </p>
          <EnquiryForm />
          <p class="contact-signoff">We look forward to welcoming you to The Scafell Hotel.</p>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .contact-grid {
    display: grid;
    gap: clamp(var(--space-m), 5vw, var(--space-l));
  }

  @media (min-width: 50rem) {
    .contact-grid {
      grid-template-columns: 1fr 1.2fr;
    }
  }

  .contact-lead {
    font-size: 1.2rem;
    line-height: 1.6;
    margin: 0 0 var(--space-m);
  }

  .contact-card {
    background: var(--c-white);
    border-radius: var(--radius);
    box-shadow: 0 10px 30px rgba(45, 53, 64, 0.08);
    padding: var(--space-m);
  }

  .contact-card h2 {
    font-size: 1.5rem;
    margin-bottom: var(--space-s);
  }

  .contact-card p {
    margin: 0 0 var(--space-m);
  }

  .contact-signoff {
    margin-top: var(--space-s);
  }

  address {
    font-style: normal;
    margin-bottom: var(--space-s);
  }
</style>
