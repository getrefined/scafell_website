---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Occasion {
  title: string;
  description: string;
  image: ImageMetadata;
  alt: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  occasions: Occasion[];
}

const { eyebrow, heading, occasions } = Astro.props;
---

<section class="occasions section">
  <div class="container">
    {eyebrow && <span class="eyebrow reveal">{eyebrow}</span>}
    <h2 class="reveal">{heading}</h2>
    <div class="occasions__grid">
      {
        occasions.map((o, i) => (
          <article class={`occasion reveal reveal-delay-${(i % 3) + 1}`}>
            <Image
              src={o.image}
              alt={o.alt}
              widths={[400, 800]}
              sizes="(min-width: 50rem) 33vw, 100vw"
            />
            <h3>{o.title}</h3>
            <p>{o.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .occasions {
    background: var(--c-white);
  }

  .occasions__grid {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
  }

  .occasion {
    min-width: 0;
  }

  .occasion img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    display: block;
    border-radius: var(--radius);
  }

  .occasion h3 {
    font-size: 1.2rem;
    margin: var(--space-s) 0 0.25rem;
  }

  .occasion p {
    margin: 0;
    font-size: 0.95rem;
  }
</style>
