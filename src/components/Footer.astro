---
import { site, bookingHref, withBase } from '../config/site';

const year = new Date().getFullYear();

/* Social links are shown even before the client supplies URLs (amend: "Add Facebook and
   Instagram page links on the footer"); '#' is the placeholder until site.ts is updated. */
const facebook = site.facebookUrl || '#';
const instagram = site.instagramUrl || '#';
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <img
        class="site-footer__icon"
        src={withBase('/icon-fell-green.svg')}
        alt={site.name}
        width="84"
        height="84"
      />
      <p class="site-footer__social">
        <a href={facebook}>Facebook</a>
        <a href={instagram}>Instagram</a>
      </p>
    </div>
    <nav aria-label="Footer">
      <ul>
        <li><a href={withBase('/rooms/')}>Rooms</a></li>
        <li><a href={withBase('/restaurant/')}>Restaurant</a></li>
        <li><a href={withBase('/private-events/')}>Events</a></li>
        <li><a href={withBase('/offers/')}>Offers</a></li>
        <li><a href={withBase('/explore/')}>Explore</a></li>
        <li><a href={withBase('/gallery/')}>Gallery</a></li>
        <li><a href={withBase('/history/')}>History</a></li>
        <li><a href={withBase('/contact/')}>Contact</a></li>
      </ul>
    </nav>
    <div>
      <p class="site-footer__address">
        {site.address.line1}<br />
        {site.address.line2}<br />
        {site.address.village}, {site.address.town}<br />
        {site.address.postcode}, {site.address.country}
      </p>
      <p class="site-footer__contact">
        <a href={site.phoneHref}>{site.phone}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <a class="btn btn--book" href={bookingHref}>Book Now</a>
    </div>
  </div>
  <p class="site-footer__legal container">
    &copy; {year}
    {site.name}, {site.tagline}
  </p>
</footer>

<style>
  .site-footer {
    background: var(--c-lake);
    color: var(--c-white);
    padding-block: var(--space-l) var(--space-m);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    margin-top: auto;
  }

  .site-footer a:not(.btn) {
    color: var(--c-sky);
    text-decoration: none;
  }
  .site-footer a:not(.btn):hover {
    text-decoration: underline;
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 40rem) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }

  .site-footer__icon {
    width: 84px;
    height: auto;
  }

  .site-footer__social {
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .site-footer__address {
    font-size: 0.9rem;
    opacity: 0.85;
    margin-bottom: var(--space-s);
  }

  .site-footer__contact {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.6;
    margin-bottom: var(--space-s);
  }

  .site-footer nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.9rem;
  }

  .site-footer__legal {
    margin-top: var(--space-l);
    font-size: 0.8rem;
    opacity: 0.6;
  }
</style>
